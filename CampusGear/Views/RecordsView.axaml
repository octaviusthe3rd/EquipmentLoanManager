<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampusGear.ViewModels"
             x:Class="CampusGear.Views.RecordsView"
             x:DataType="vm:RecordsViewModel">

    <Grid Margin="26,22" RowDefinitions="Auto,*" RowSpacing="14">

        <StackPanel Grid.Row="0">
            <TextBlock Classes="pageTitle" Text="Records"/>
            <TextBlock Classes="pageSub" Text="Active loans and the full completed history for this session."/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Active Loans">
                <Border Classes="card" Margin="0,10,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="thead">
                            <Grid ColumnDefinitions="100,*,120,170">
                                <TextBlock Classes="th" Grid.Column="0" Text="Loan ID"/>
                                <TextBlock Classes="th" Grid.Column="1" Text="Borrower"/>
                                <TextBlock Classes="th" Grid.Column="2" Text="Item"/>
                                <TextBlock Classes="th" Grid.Column="3" Text="Category"/>
                            </Grid>
                        </Border>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Active}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LoanRow">
                                        <Border Classes="trow">
                                            <Grid ColumnDefinitions="100,*,120,170">
                                                <TextBlock Grid.Column="0" Text="{Binding LoanId}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Borrower}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ItemId}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Category}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Completed Loans">
                <Border Classes="card" Margin="0,10,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="thead">
                            <Grid ColumnDefinitions="100,*,120,170,120">
                                <TextBlock Classes="th" Grid.Column="0" Text="Loan ID"/>
                                <TextBlock Classes="th" Grid.Column="1" Text="Borrower"/>
                                <TextBlock Classes="th" Grid.Column="2" Text="Item"/>
                                <TextBlock Classes="th" Grid.Column="3" Text="Category"/>
                                <TextBlock Classes="th" Grid.Column="4" Text="Status"/>
                            </Grid>
                        </Border>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Completed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LoanRow">
                                        <Border Classes="trow">
                                            <Grid ColumnDefinitions="100,*,120,170,120">
                                                <TextBlock Grid.Column="0" Text="{Binding LoanId}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Borrower}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ItemId}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Category}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Status}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
