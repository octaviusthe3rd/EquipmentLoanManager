<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.card">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 #1A0F172A"/>
    </Style>

    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector="TextBlock.pageSub">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#475569"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#111827"/>
    </Style>
    <Style Selector="TextBlock.kpiLabel">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#475569"/>
    </Style>
    <Style Selector="TextBlock.kpiValue">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <!-- Table look (header row + data rows) -->
    <Style Selector="Border.thead">
        <Setter Property="Background" Value="#EEF2F7"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="TextBlock.th">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector="Border.trow">
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,9"/>
    </Style>
    <Style Selector="Border.trow TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#111827"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Sidebar buttons -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Status pills -->
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="#DCFCE7"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,2"/>
    </Style>
    <Style Selector="Border.pill.borrowed">
        <Setter Property="Background" Value="#FFEDD5"/>
    </Style>
    <Style Selector="Border.trow Border.pill > TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#14532D"/>
    </Style>
    <Style Selector="Border.trow Border.pill.borrowed > TextBlock">
        <Setter Property="Foreground" Value="#7C2D12"/>
    </Style>

    <!-- Message banners -->
    <Style Selector="Border.note">
        <Setter Property="Background" Value="#DCFCE7"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.note.error">
        <Setter Property="Background" Value="#FEE2E2"/>
    </Style>
    <Style Selector="Border.note > TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#14532D"/>
    </Style>
    <Style Selector="Border.note.error > TextBlock">
        <Setter Property="Foreground" Value="#7F1D1D"/>
    </Style>
    <Style Selector="Border.info">
        <Setter Property="Background" Value="#E0F2FE"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.info TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#374151"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#1D4ED8"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1E40AF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1E3A8A"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Foreground" Value="#4B5563"/>
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="BorderBrush" Value="#6B7280"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="Foreground" Value="#1F2937"/>
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Foreground" Value="#4B5563"/>
    </Style>

    <!-- Selectable table (ListBox) -->
    <Style Selector="ListBox.table">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.table ListBoxItem">
        <Setter Property="Padding" Value="0"/>
    </Style>
</Styles>
